<dialog class="settingsModal" id="networkSettings">
			<h1>Сетевые настройки</h1>
			<table class="settingsTable">
				<tr>
					<th>Параметр</th>
					<th>Значение</th>
				</tr>
                <tr>
					<td>Получение ip адреса</td>
					<td>
						<div class="dhcp" >
    						<input type="radio" id="dhcpon" name="dhcp" oninput="dhcpOn();"/>
    						<label for="dhcpon" style="margin: 0px 0px 0px 5px;">Статический</label>
						</div>
						<div class="dhcp" >
    						<input type="radio" id="dhcpoff" name="dhcp" oninput="dhcpOff();"/>
    						<label for="dhcpon" style="margin: 0px 0px 0px 5px;">Автоматический</label>
						</div>
                    </td>
				</tr>
				<tr>
					<td>Ip адрес</td>
					<td><input type="text" class="settingsInput ipAddress" id="ipAddress" placeholder="XXX.XXX.XXX.XXX" oninput="_settings.ip = this.value;"></td>
				</tr>
				<tr>
					<td>Маска подсети</td>
					<td><input type="text" class="settingsInput ipAddress" id="netMask" placeholder="XXX.XXX.XXX.XXX" oninput="_settings.mask = this.value;"></td>
				</tr>
				<tr>
					<td>Шлюз</td>
					<td><input type="text" class="settingsInput ipAddress" id="gateway" placeholder="XXX.XXX.XXX.XXX" oninput="_settings.gateway = this.value;"></td>
				</tr>
				<tr>
					<td>Предпочитаемый DNS</td>
					<td><input type="text" class="settingsInput ipAddress" id="fistdns" placeholder="XXX.XXX.XXX.XXX" oninput="_settings.fistdns = this.value;"></td>
				</tr>
                <tr>
					<td>Альтернативный DNS</td>
					<td><input type="text" class="settingsInput ipAddress" id="seconddns" placeholder="XXX.XXX.XXX.XXX" oninput="_settings.seconddns = this.value;"></td>
				</tr>

			</table>
    <footer>
        <button class="modalButton okBtn" onclick="applySettings()">OK</button>	
		<button class="modalButton cancelBtn" onclick="closeSettings()">Отмена</button>			
    </footer>
</dialog>

<dialog id="rebootModal">
    <h1>Общие настройки</h1>
     <footer>
        <button class="modalButton yesBtn" onclick="closeModal()">ДА</button>
        <button class="modalButton noBtn" onclick="closeModal()">HET</button>				
    </footer>
</dialog>

<script script language="JavaScript" type="text/javascript" src="networkSettings.js"></script>