                        <rect x="1" y="3" width="26" height="22" rx="2" fill="none" stroke="#38bdf8" stroke-width="1.5"/>
                        <polygon points="27,9 39,4 39,24 27,19" fill="none" stroke="#38bdf8" stroke-width="1.5"/>
