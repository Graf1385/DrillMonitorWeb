        </button>
    </div>

    <div id="ni_settingsBody">
    <table class="settingsTable addItemTable">
        <tr>
            <th>Параметр</th>
            <th>Значение</th>
        </tr>

        <tr><td colspan="2" class="sectionLabel">Размер</td></tr>
        <tr>
            <td>Ширина / Высота (px)</td>
            <td class="paramCell">
                <input type="number" class="settingsInput sizeInput" id="ni_width"  placeholder="авто" min="40" max="2000">
                <input type="number" class="settingsInput sizeInput" id="ni_height" placeholder="авто" min="40" max="2000">
            </td>
        </tr>

        <tr><td colspan="2" class="sectionLabel">Заголовок</td></tr>
        <tr>
            <td>Текст</td>
            <td><input type="text" class="settingsInput" id="ni_headerText" value="Заголовок"></td>
        </tr>
        <tr>
            <td>Цвет текста / фона</td>
            <td class="paramCell">
                <input type="color" id="ni_headerColor" value="#c9d1d9">
                <input type="color" id="ni_headerBg"    value="#161b22">
            </td>
        </tr>
        <tr>
            <td>Шрифт / размер (%)</td>
            <td class="paramCell">
                <select class="settingsSelect" id="ni_headerFont">
                    <option value="0">Monospace</option>
                </select>
                <input type="number" class="settingsInput sizeInput" id="ni_headerSize" value="17" min="1" max="200">
            </td>
        </tr>

        <tr><td colspan="2" class="sectionLabel">Значение</td></tr>
        <tr id="ni_paramRow">
            <td>Параметр</td>
            <td style="padding:2px 4px">
                <div class="unitCombo">
                    <input type="text" class="settingsInput" id="ni_paramId"
                           placeholder="— не выбран —" autocomplete="off"
                           oninput="openParamDropdown(this)"
                           onfocus="openParamDropdown(this)"
                           onblur="closeParamDropdown()">
                    <div class="unitComboDropdown" id="ni_paramDropdown"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td>Формат</td>
            <td><input type="text" class="settingsInput" id="ni_format" placeholder="например: 0000.00"></td>
        </tr>
        <tr class="numericOnlyRow">
            <td>Диапазон (мин / макс)</td>
            <td class="paramCell">
                <input type="number" step="any" class="settingsInput sizeInput" id="ni_rangeMin" value="0">
                <input type="number" step="any" class="settingsInput sizeInput" id="ni_rangeMax" value="100">
            </td>
        </tr>
        <tr>
            <td>Шрифт / размер (px)</td>
            <td class="paramCell">
                <select class="settingsSelect" id="ni_valueFont">
                    <option value="0">Monospace</option>
                </select>
                <input type="number" class="settingsInput sizeInput" id="ni_valueSize" value="30" min="1" max="400">
            </td>
        </tr>
        <tr>
            <td>Цвет текста / фона</td>
            <td class="paramCell">
                <input type="color" id="ni_valueColor" value="#38bdf8">
                <input type="color" id="ni_valueBg"    value="#0d1117">
            </td>
        </tr>

        <tr><td colspan="2" class="sectionLabel">Дополнительно</td></tr>
        <tr class="numericOnlyRow">
            <td>Единицы измерения</td>
            <td>
                <div class="unitCombo">
                    <input type="text" class="settingsInput" id="ni_units"
                           placeholder="МПа, °C, об/мин…" autocomplete="off"
                           oninput="openUnitsDropdown(this)"
                           onfocus="openUnitsDropdown(this)"
                           onblur="closeUnitsDropdown()">
                    <div class="unitComboDropdown" id="ni_unitsDropdown"></div>
                </div>
            </td>
        </tr>
        <tr class="zoneColorRow">
            <td>Цвет значения по зонам</td>
            <td><input type="checkbox" id="ni_zoneColors" class="settingsCheckbox"></td>
        </tr>
        <tr class="tickerOnlyRow">
            <td>Скорость прокрутки (сек)</td>
            <td><input type="number" class="settingsInput sizeInput" id="ni_tickerSpeed" value="12" min="2" max="120" step="1"></td>
        </tr>
        <tr>
            <td>Прозрачность фона</td>
            <td class="paramCell">
                <input type="range" id="ni_valueBgOpacity" min="0" max="1" step="0.05" value="0"
                    class="alarmVolumeSlider" oninput="document.querySelector('#ni_opacityVal').textContent=Math.round(this.value*100)+'%'">
                <span id="ni_opacityVal" class="alarmVolumeNum">0%</span>
            </td>
        </tr>

        <tr class="numericOnlyRow"><td colspan="2" class="sectionLabel">Сигнализация</td></tr>
        <tr class="numericOnlyRow">
            <td>Включить сигнализацию</td>
            <td><input type="checkbox" id="ni_alarmEnabled" class="settingsCheckbox" onchange="toggleAlarmFields(this.checked)"></td>
        </tr>
        <tr class="numericOnlyRow">
            <td>Порог срабатывания (мин / макс)</td>
            <td class="paramCell">
                <input type="number" step="any" class="settingsInput sizeInput" id="ni_alarmMin" placeholder="—">
                <input type="number" step="any" class="settingsInput sizeInput" id="ni_alarmMax" placeholder="—">
            </td>
        </tr>
        <tr class="numericOnlyRow">
            <td>Цвет световой сигнализации</td>
            <td><input type="color" id="ni_alarmColor" value="#ff0000"></td>
        </tr>
    </table>
    </div>

    <footer>
        <button class="modalButton okBtn"     onclick="addNewItem()">Добавить</button>
        <button class="modalButton cancelBtn" onclick="closeAddItemModal()">Отмена</button>
    </footer>
</dialog>

<div id="indicatorContextMenu" class="indicatorCtxMenu">
    <button id="ctxSettingsBtn" onclick="ctxOpenValueSettings()">Настройки</button>
    <button id="ctxTestBtn" onclick="ctxTestIndicator()">Тест</button>
    <button id="ctxAckBtn" onclick="ctxAckAlarm()" style="display:none">Квитировать тревогу</button>
    <button class="ctxMenuDanger" onclick="ctxDeleteIndicator()">Удалить</button>
</div>

<dialog class="settingsModal" id="testIndicatorModal">
    <h1>Тест</h1>
    <table class="settingsTable">
        <tr>
            <td>Значение</td>
            <td class="paramCell">
                <input type="range" id="testRange" class="alarmVolumeSlider"
                    oninput="onTestRangeInput(this.value)">
                <input type="number" id="testNum" class="settingsInput" style="width:80px"
                    oninput="onTestNumInput(this.value)">
            </td>
        </tr>
    </table>
    <footer>
        <button class="modalButton cancelBtn" onclick="closeTestModal()">Закрыть</button>
    </footer>
</dialog>

<dialog class="settingsModal" id="deleteConfirmModal">
    <h1>Удаление индикатора</h1>
    <p class="modalMessage">Вы уверены, что хотите удалить индикатор?</p>
    <footer>
        <button class="modalButton deleteBtn" onclick="confirmDeleteIndicator()">Да</button>
        <button class="modalButton cancelBtn" onclick="document.querySelector('#deleteConfirmModal').close()">Нет</button>
    </footer>
</dialog>

<dialog class="settingsModal wideModal" id="indicatorListModal">
    <h1>Список индикаторов</h1>
    <div id="indicatorListBody"></div>
    <footer>
        <button class="modalButton cancelBtn" onclick="document.querySelector('#indicatorListModal').close()">Закрыть</button>
    </footer>
</dialog>

<dialog class="settingsModal wideModal" id="parametersModal">
    <nav class="pmTabBar">
        <button class="pmTab pmTabActive" id="pmTabBtnParams" onclick="switchParamTab('params')">Параметры</button>
        <button class="pmTab"             id="pmTabBtnUnits"  onclick="switchParamTab('units')">Единицы измерения</button>
    </nav>

    <div id="pmPanelParams" class="pmPanel">
        <div id="parametersBody" class="pmScrollable"></div>
    </div>

    <div id="pmPanelUnits" class="pmPanel" style="display:none">
        <div id="unitsBody" class="pmScrollable"></div>
    </div>

    <footer>
        <input type="file" id="paramImportFile" accept=".json" style="display:none" onchange="importParametersFile(this)">
        <input type="file" id="unitsImportFile" accept=".json" style="display:none" onchange="importUnitsFile(this)">
        <div class="pmFooterRow">
            <button class="modalButton okBtn" onclick="pmAddRow()">+ Добавить</button>
            <button class="modalButton" onclick="pmExport()">Экспорт JSON</button>
            <button class="modalButton" onclick="pmImport()">Импорт JSON</button>
        </div>
        <div class="pmFooterRow">
            <button class="modalButton okBtn" onclick="saveParameters()">Сохранить</button>
            <button class="modalButton cancelBtn" onclick="document.querySelector('#parametersModal').close()">Отмена</button>
        </div>
    </footer>
</dialog>


<dialog class="settingsModal" id="loginModal">
    <h1>Авторизация</h1>
    <table class="settingsTable">
        <tr>
            <td>Пользователь</td>
            <td><input type="text" class="settingsInput" id="login_name" value="admin" autocomplete="username"></td>
        </tr>
        <tr>
            <td>Пароль</td>
            <td><input type="password" class="settingsInput" id="login_password" autocomplete="current-password" onkeydown="if(event.key==='Enter')submitLogin()"></td>
        </tr>
    </table>
    <footer>
        <button class="modalButton okBtn" onclick="submitLogin()">Войти</button>
        <button class="modalButton cancelBtn" onclick="document.querySelector('#loginModal').close()">Отмена</button>
    </footer>
</dialog>

<dialog class="settingsModal" id="addItemErrorModal">
    <h1>Ошибка</h1>
    <p class="modalMessage">Необходимо выбрать параметр индикатора.</p>
    <footer>
        <button class="modalButton okBtn" onclick="document.querySelector('#addItemErrorModal').close()">OK</button>
    </footer>
</dialog>

<dialog class="settingsModal" id="videoSettingsModal">
    <h1>Настройки видеопотока</h1>
    <table class="settingsTable addItemTable">
        <tr><td colspan="2" class="sectionLabel">Камера (ONVIF / RTSP)</td></tr>
        <tr>
            <td>Заголовок</td>
            <td><input type="text" class="settingsInput" id="vs_title" value="Камера"></td>
        </tr>
        <tr>
            <td>Адрес (IP / хост)</td>
            <td><input type="text" class="settingsInput" id="vs_host" placeholder="192.168.1.100"></td>
        </tr>
        <tr>
            <td>Порт RTSP</td>
            <td><input type="number" class="settingsInput sizeInput" id="vs_port" value="554" min="1" max="65535"></td>
        </tr>
        <tr>
            <td>Пользователь</td>
            <td><input type="text" class="settingsInput" id="vs_username" placeholder="admin" autocomplete="off"></td>
        </tr>
        <tr>
            <td>Пароль</td>
            <td><input type="password" class="settingsInput" id="vs_password" autocomplete="off"></td>
        </tr>
        <tr>
            <td>Канал</td>
            <td><input type="number" class="settingsInput sizeInput" id="vs_channel" value="1" min="1" max="64"></td>
        </tr>
        <tr>
            <td>Субпоток</td>
            <td><input type="checkbox" class="settingsCheckbox" id="vs_substream"></td>
        </tr>
        <tr><td colspan="2" class="sectionLabel">Размер виджета</td></tr>
        <tr>
            <td>Ширина / Высота (px)</td>
            <td class="paramCell">
                <input type="number" class="settingsInput sizeInput" id="vs_width"  value="320" min="160" max="2000">
                <input type="number" class="settingsInput sizeInput" id="vs_height" value="240" min="120" max="2000">
            </td>
        </tr>
    </table>
    <footer>
        <button class="modalButton okBtn"     onclick="submitVideoSettings()">Применить</button>
        <button class="modalButton cancelBtn" onclick="document.querySelector('#videoSettingsModal').close()">Отмена</button>
    </footer>
</dialog>

<dialog class="settingsModal" id="ahSettingsModal">
    <h1>История сигнализаций — настройки</h1>
    <table class="settingsTable">
        <tr><td colspan="2" class="sectionLabel">Заголовок</td></tr>
        <tr>
            <td>Шрифт / размер (px)</td>
