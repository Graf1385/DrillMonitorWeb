<dialog class="settingsModal" id="newItemModal">
    <h1>Добавить элемент</h1>

    <div class="itemTypeList" id="itemTypeList">
        <button class="itemTypeCard selected" id="typeDigital" onclick="selectItemType('digitalIndicator')">
            <div class="itemTypeCardPreview">
                <div class="previewHeader">Заголовок</div>
                <div class="previewValue">0.0</div>
            </div>
            <span>Цифровой индикатор</span>
        </button>
        <button class="itemTypeCard" id="typeTime" onclick="selectItemType('timeIndicator')">
            <div class="itemTypeCardPreview">
                <div class="previewHeader">Заголовок</div>
                <div class="previewValue">00:00:00</div>
            </div>
            <span>Индикатор времени</span>
        </button>
        <button class="itemTypeCard" id="typeDate" onclick="selectItemType('dateIndicator')">
            <div class="itemTypeCardPreview">
                <div class="previewHeader">Дата</div>
                <div class="previewValue" style="font-size:13px;">дд.мм.гг</div>
            </div>
            <span>Индикатор даты</span>
        </button>
    </div>

    <div id="ni_settingsBody">
    <table class="settingsTable addItemTable">
        <tr>
            <th>Параметр</th>
            <th>Значение</th>
        </tr>

        <tr><td colspan="2" class="sectionLabel">Размер</td></tr>
        <tr>
            <td>Ширина / Высота (px)</td>
            <td class="paramCell">
                <input type="number" class="settingsInput sizeInput" id="ni_width"  placeholder="авто" min="40" max="2000">
                <input type="number" class="settingsInput sizeInput" id="ni_height" placeholder="авто" min="40" max="2000">
            </td>
        </tr>

        <tr><td colspan="2" class="sectionLabel">Заголовок</td></tr>
        <tr>
            <td>Текст</td>
            <td><input type="text" class="settingsInput" id="ni_headerText" value="Заголовок"></td>
        </tr>
        <tr>
            <td>Цвет текста / фона</td>
            <td class="paramCell">
                <input type="color" id="ni_headerColor" value="#c9d1d9">
                <input type="color" id="ni_headerBg"    value="#161b22">
            </td>
        </tr>
        <tr>
            <td>Шрифт / размер</td>
            <td class="paramCell">
                <select class="settingsSelect" id="ni_headerFont">
                    <option value="monospace">Monospace</option>
                    <option value="'Courier New'">Courier New</option>
                    <option value="Consolas">Consolas</option>
                    <option value="Arial">Arial</option>
                    <option value="'Segoe UI'">Segoe UI</option>
                </select>
                <input type="number" class="settingsInput sizeInput" id="ni_headerSize" value="14" min="8" max="72">
            </td>
        </tr>

        <tr><td colspan="2" class="sectionLabel">Значение</td></tr>
        <tr>
            <td>Параметр</td>
            <td>
                <select class="settingsSelect" id="ni_paramId" onchange="onParamChange(this)">
                    <option value="">— не выбран —</option>
                </select>
            </td>
        </tr>
        <tr>
            <td>Формат</td>
            <td><input type="text" class="settingsInput" id="ni_format" placeholder="например: 0000.00"></td>
        </tr>
        <tr class="numericOnlyRow">
            <td>Диапазон (мин / макс)</td>
            <td class="paramCell">
                <input type="number" step="any" class="settingsInput sizeInput" id="ni_rangeMin" value="0">
                <input type="number" step="any" class="settingsInput sizeInput" id="ni_rangeMax" value="100">
            </td>
        </tr>
        <tr>
            <td>Шрифт / размер</td>
            <td class="paramCell">
                <select class="settingsSelect" id="ni_valueFont">
                    <option value="monospace">Monospace</option>
                    <option value="'Courier New'">Courier New</option>
                    <option value="Consolas">Consolas</option>
                    <option value="Arial">Arial</option>
                    <option value="'Segoe UI'">Segoe UI</option>
                </select>
                <input type="number" class="settingsInput sizeInput" id="ni_valueSize" value="48" min="12" max="120">
            </td>
        </tr>
        <tr>
            <td>Цвет текста / фона</td>
            <td class="paramCell">
                <input type="color" id="ni_valueColor" value="#38bdf8">
                <input type="color" id="ni_valueBg"    value="#0d1117">
            </td>
        </tr>
    </table>
    </div>

    <footer>
        <button class="modalButton okBtn"     onclick="addNewItem()">Добавить</button>
        <button class="modalButton cancelBtn" onclick="closeAddItemModal()">Отмена</button>
    </footer>
</dialog>

<div id="indicatorContextMenu" class="indicatorCtxMenu">
    <button onclick="ctxOpenValueSettings()">Настройка значения</button>
    <button onclick="ctxOpenAlarmSettings()">Настройка сигнализации</button>
    <button class="ctxMenuDanger" onclick="ctxDeleteIndicator()">Удалить</button>
</div>

<dialog class="settingsModal" id="alarmSettingsModal">
    <h1>Настройка сигнализации</h1>
    <table class="settingsTable">
        <tr>
            <th>Параметр</th>
            <th>Значение</th>
        </tr>
        <tr><td colspan="2" class="sectionLabel">Сигнализация</td></tr>
        <tr>
            <td>Мин / Макс</td>
            <td class="paramCell">
                <input type="number" step="any" class="settingsInput sizeInput" id="as_alarmMin" placeholder="—">
                <input type="number" step="any" class="settingsInput sizeInput" id="as_alarmMax" placeholder="—">
            </td>
        </tr>
        <tr>
            <td>Цвет световой сигнализации</td>
            <td><input type="color" id="as_alarmColor" value="#ff0000"></td>
        </tr>
        <tr><td colspan="2" class="sectionLabel">Звуковая сигнализация</td></tr>
        <tr>
            <td>Звук</td>
            <td>
                <select class="settingsSelect" id="as_alarmSound">
                    <option value="">— без звука —</option>
                    <option value="beep">Звуковой сигнал</option>
                    <option value="siren">Сирена</option>
                    <option value="pulse">Импульс</option>
                    <option value="alert">Тревога</option>
                </select>
            </td>
        </tr>
        <tr>
            <td>Громкость</td>
            <td class="paramCell">
                <input type="range" id="as_alarmVolume" min="0" max="100" value="50" class="alarmVolumeSlider" oninput="document.querySelector('#as_alarmVolumeVal').textContent=this.value">
                <span id="as_alarmVolumeVal" class="alarmVolumeNum">50</span>
            </td>
        </tr>
        <tr>
            <td>Задержка (сек)</td>
            <td><input type="number" step="0.5" min="0.5" max="60" class="settingsInput" id="as_alarmDelay" value="2"></td>
        </tr>
    </table>
    <footer>
        <button class="modalButton okBtn"     onclick="applyAlarmSettings()">Применить</button>
        <button class="modalButton cancelBtn" onclick="document.querySelector('#alarmSettingsModal').close()">Отмена</button>
    </footer>
</dialog>

<dialog class="settingsModal" id="deleteConfirmModal">
    <h1>Удаление индикатора</h1>
    <p class="modalMessage">Вы уверены, что хотите удалить индикатор?</p>
    <footer>
        <button class="modalButton deleteBtn" onclick="confirmDeleteIndicator()">Да</button>
        <button class="modalButton cancelBtn" onclick="document.querySelector('#deleteConfirmModal').close()">Нет</button>
    </footer>
</dialog>

<dialog class="settingsModal" id="addItemErrorModal">
    <h1>Ошибка</h1>
    <p class="modalMessage">Необходимо выбрать параметр индикатора.</p>
    <footer>
        <button class="modalButton okBtn" onclick="document.querySelector('#addItemErrorModal').close()">OK</button>
    </footer>
</dialog>
