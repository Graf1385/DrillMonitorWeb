<dialog class="settingsModal" id="settings">
    <h1>Настройки рабочего поля</h1>
    <table class="settingsTable">
        <tr>
            <th>Параметр</th>
            <th>Значение</th>
        </tr>
        <tr>
            <td>Профиль</td>
            <td class="profileCell">
                <select class="settingsSelect" id="wsProfile" onchange="applyProfile(this)"></select>
                <button class="profileIconBtn saveBtn"   onclick="showCreateProfileModal()" title="Создать профиль">+</button>
                <button class="profileIconBtn deleteBtn" id="deleteProfileBtn" onclick="showDeleteProfileModal()" title="Удалить профиль">✕</button>
            </td>
        </tr>
        <tr>
            <td>Цвет фона</td>
            <td><input type="color" id="workSpaceColor"></td>
        </tr>
        <tr>
            <td>Размер ячейки (px)</td>
            <td><input type="number" class="settingsInput" id="cellSize" placeholder="20" min="10" max="200"></td>
        </tr>
        <tr>
            <td>Разрешение пульта</td>
            <td>
                <select class="settingsSelect wsResSelect" id="wsResolution">
                    <option value="0x0">Авто</option>
                    <option value="3840x2160">3840 × 2160 (4K)</option>
                    <option value="2560x1440">2560 × 1440 (QHD)</option>
                    <option value="1920x1080">1920 × 1080 (Full HD)</option>
                    <option value="1280x720">1280 × 720 (HD)</option>
                    <option value="1024x768">1024 × 768</option>
                    <option value="800x600">800 × 600</option>
                </select>
            </td>
        </tr>
        <tr><td colspan="2" class="sectionLabel">Источник данных</td></tr>
        <tr>
            <td>Смещение UTC (ч)</td>
            <td><input type="number" class="settingsInput" id="ws_timezone" min="-12" max="12" step="1" placeholder="смещение"></td>
        </tr>
        <tr><td colspan="2" class="sectionLabel">Звуковая сигнализация</td></tr>
        <tr>
            <td>Звук</td>
            <td class="paramCell">
                <select class="settingsSelect" id="ws_alarmSound" style="flex:1"></select>
                <button class="profileIconBtn" id="ws_alarmPlayBtn" onclick="testAlarmSound()" title="Тест">▶</button>
            </td>
        </tr>
        <tr>
            <td>Громкость</td>
            <td class="paramCell">
                <input type="range" id="ws_alarmVolume" min="0" max="100" value="50" class="alarmVolumeSlider"
                    oninput="document.querySelector('#ws_alarmVolumeVal').textContent=this.value">
                <span id="ws_alarmVolumeVal" class="alarmVolumeNum">50</span>
            </td>
        </tr>
        <tr>
            <td>Задержка (сек)</td>
            <td><input type="number" step="0.5" min="0.5" max="60" class="settingsInput" id="ws_alarmDelay" value="2"></td>
        </tr>
        <tr><td colspan="2" class="sectionLabel">Сайдбар</td></tr>
        <tr>
            <td>Таймаут скрытия (сек)</td>
            <td><input type="number" step="1" min="0" max="3600" class="settingsInput" id="ws_sidebarTimeout" value="20" placeholder="0 — отключено"></td>
        </tr>
    </table>
    <footer>
        <input type="file" id="profileImportFile" accept=".json" style="display:none" onchange="importProfile(this)">
        <div class="pmFooterRow">
            <button class="modalButton" onclick="exportProfile()">Экспорт JSON</button>
            <button class="modalButton" onclick="document.querySelector('#profileImportFile').click()">Импорт JSON</button>
        </div>
        <div class="pmFooterRow">
            <button class="modalButton okBtn"     onclick="applyWorkSpaceSettings()">OK</button>
            <button class="modalButton cancelBtn" onclick="closeWorkSpaceSettings()">Отмена</button>
        </div>
    </footer>
</dialog>

<dialog class="settingsModal" id="createProfileModal">
    <h1>Новый профиль</h1>
    <div class="modalInputRow">
        <input type="text" class="settingsInput" id="newProfileName" placeholder="Введите название">
    </div>
    <footer>
        <button class="modalButton okBtn"     onclick="createProfileConfirm()">OK</button>
        <button class="modalButton cancelBtn" onclick="closeCreateProfileModal()">Отмена</button>
    </footer>
</dialog>

<dialog class="settingsModal" id="deleteProfileModal">
    <h1>Удаление профиля</h1>
    <p class="modalMessage" id="deleteProfileMessage"></p>
    <footer>
        <button class="modalButton okBtn"     onclick="deleteProfileConfirm()">Да</button>
        <button class="modalButton cancelBtn" onclick="closeDeleteProfileModal()">Нет</button>
    </footer>
</dialog>

<script script language="JavaScript" type="text/javascript" src="workSpaceSettings.js"></script>
