<dialog class="settingsModal" id="settings">
    <h1>Настройки рабочего поля</h1>
    <table class="settingsTable">
        <tr>
            <th>Параметр</th>
            <th>Значение</th>
        </tr>
        <tr>
            <td>Профиль</td>
            <td>
                <select class="settingsSelect" id="wsProfile" onchange="applyProfile(this.value)">
                    <option value="default">Стандартный</option>
                </select>
            </td>
        </tr>
        <tr>
            <td>Цвет фона</td>
            <td><input type="color" id="workSpaceColor" onchange="selectCustomProfile()"></td>
        </tr>
        <tr>
            <td>Размер ячейки</td>
            <td><input type="number" class="settingsInput" id="cellSize" placeholder="20" min="10" max="200" oninput="selectCustomProfile()"></td>
        </tr>
    </table>
    <footer>
        <button class="modalButton okBtn" onclick="applyWorkSpaceSettings()">OK</button>
        <button class="modalButton cancelBtn" onclick="closeWorkSpaceSettings()">Отмена</button>
    </footer>
</dialog>

<script script language="JavaScript" type="text/javascript" src="workSpaceSettings.js"></script>
