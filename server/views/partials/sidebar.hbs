
<div id="sideBar">
    <div id="sideBarLogo">
        <img src="BCS_logo.svg"></img>
    </div>
    <div id="buttonModul">

        <!-- Старт / Стоп источника данных -->
        <button id="dsRunButton" onclick="dsToggleRun()" class="sideBarButton" title="Старт / Стоп источника данных">
            <svg id="dsRunIcon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="5,3 19,12 5,21" fill="currentColor" fill-opacity="0.18" stroke="currentColor"/>
            </svg>
        </button>

        <!-- Рабочее пространство / дисплей -->
        <button id="workSpaceSettings" onclick="showWorkSpaceSettings()" class="sideBarButton">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="13" rx="2.5" fill="currentColor" fill-opacity="0.12"/>
                <path d="M8 21h8M12 16v5"/>
                <path d="M7 7.5h4M7 11h6" stroke-width="1.2" opacity="0.5"/>
            </svg>
        </button>

        <!-- Сетка -->
        <button id="gridButton" onclick="toggleGrid()" class="sideBarButton">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3"  y="3"  width="7" height="7" rx="1.5" fill="currentColor" fill-opacity="0.18"/>
                <rect x="14" y="3"  width="7" height="7" rx="1.5" fill="currentColor" fill-opacity="0.07"/>
                <rect x="14" y="14" width="7" height="7" rx="1.5" fill="currentColor" fill-opacity="0.18"/>
                <rect x="3"  y="14" width="7" height="7" rx="1.5" fill="currentColor" fill-opacity="0.07"/>
            </svg>
        </button>

        <!-- Список индикаторов / сигнал -->
        <button id="indicatorListButton" onclick="showIndicatorList()" class="sideBarButton">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
                <circle cx="9"  cy="3"  r="1.8" fill="currentColor" fill-opacity="0.6" stroke="none"/>
                <circle cx="15" cy="21" r="1.8" fill="currentColor" fill-opacity="0.6" stroke="none"/>
            </svg>
        </button>


        <!-- Параметры / слайдеры -->
        <button id="parametersButton" onclick="showParameters()" class="sideBarButton">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="4"  x2="4"  y1="21" y2="12"/>
                <line x1="4"  x2="4"  y1="6"  y2="3"/>
                <line x1="12" x2="12" y1="21" y2="10"/>
                <line x1="12" x2="12" y1="4"  y2="3"/>
                <line x1="20" x2="20" y1="21" y2="14"/>
                <line x1="20" x2="20" y1="8"  y2="3"/>
                <circle cx="4"  cy="9"  r="2.5" fill="currentColor" fill-opacity="0.18" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="12" cy="7"  r="2.5" fill="currentColor" fill-opacity="0.18" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="20" cy="11" r="2.5" fill="currentColor" fill-opacity="0.18" stroke="currentColor" stroke-width="1.5"/>
            </svg>
        </button>

        <!-- Логи / документ -->
        <button id="logButton" onclick="showLogs()" class="sideBarButton">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" fill="currentColor" fill-opacity="0.12"/>
                <path d="M14 2v4a2 2 0 0 0 2 2h4"/>
                <path d="M10 9H8M16 13H8M16 17H8" stroke-width="1.3"/>
            </svg>
        </button>

        <!-- Источник данных -->
        <button id="dataSourceButton" onclick="showDataSourceSettings()" class="sideBarButton" title="Источник данных">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <ellipse cx="12" cy="5"  rx="9" ry="3" fill="currentColor" fill-opacity="0.12"/>
                <path d="M21 5v4c0 1.66-4.03 3-9 3S3 10.66 3 9V5"/>
                <path d="M21 9v4c0 1.66-4.03 3-9 3S3 14.66 3 13V9"/>
                <path d="M21 13v4c0 1.66-4.03 3-9 3s-9-1.34-9-3v-4"/>
            </svg>
        </button>

        <!-- Добавить -->
        <button id="addButton" onclick="showNewItems()" class="sideBarButton">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9" fill="currentColor" fill-opacity="0.1"/>
                <path d="M12 8v8M8 12h8" stroke-width="1.8"/>
            </svg>
        </button>

        <!-- Проверить обновления -->
        <button id="updateCheckButton" class="sideBarButton" title="Проверить обновления">
            <span id="updateBadge" class="updateBadge"></span>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" fill="currentColor" fill-opacity="0.1" stroke="none"/>
                <path d="M21 3v5h-5"/>
                <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
                <path d="M8 16H3v5"/>
            </svg>
        </button>

        <!-- Удалить -->
        <button id="removeButton" onclick="removeItem()" class="sideBarButton">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 6h18"/>
                <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" fill="currentColor" fill-opacity="0.12"/>
                <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                <line x1="10" x2="10" y1="11" y2="17" stroke-width="1.3"/>
                <line x1="14" x2="14" y1="11" y2="17" stroke-width="1.3"/>
            </svg>
        </button>
    </div>

    <!-- Сохранить -->
    <button id="saveButton" onclick="saveSettings()" class="sideBarButton">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" fill="currentColor" fill-opacity="0.12"/>
            <polyline points="17 21 17 13 7 13 7 21"/>
            <polyline points="7 3 7 8 15 8"/>
        </svg>
    </button>
</div>

<script script language="JavaScript" type="text/javascript" src="sidebar.js"></script>
