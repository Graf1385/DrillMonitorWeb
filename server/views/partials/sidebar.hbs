
<div id="sideBar">
    <div id="sideBarLogo">
        <img src="BCS_logo.svg"></img>
    </div>			
    <button id="workSpaceSettings" onclick="showWorkSpaceSettings()" class="sideBarButton">
        <img src="workSpaceSettings.png"></img>
    </button>
     <button id="networkSettings" onclick="showNetworkSettings()" class="sideBarButton">
        <img src="networkSettings.png"></img>
    </button>
    <button id="netButton" onclick="_settings.gridState = this.classList.contains('enable');" class="sideBarButton">
        <img src="net.svg"></img>
    </button>
    <button id="addButton" onclick="addItem('digitalIndicator')" class="sideBarButton">
        <img src="add.svg"></img>
    </button>			
    <button id="removeButton" onclick="removeItem()"  class="sideBarButton">
        <img src="remove.svg"></img>
    </button>					
    <button id="saveButton" onclick="saveSettings()" class="sideBarButton">
        <img src="save.png"></img>
    </button>			
</div>

<script script language="JavaScript" type="text/javascript" src="sidebar.js"></script>